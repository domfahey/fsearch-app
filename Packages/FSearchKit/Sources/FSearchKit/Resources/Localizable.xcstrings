{
  "sourceLanguage": "en",
  "strings": {
    "%@ belongs to another user.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gehört einem anderen Benutzer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ belongs to another user."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pertenece a otro usuario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ appartient à un autre utilisateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は別のユーザーが所有しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 파일은 다른 사용자 소유입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pertence a outro usuário."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 属于其他用户。"
          }
        }
      }
    },
    "%@ files so far… usually under a minute.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisher %@ Dateien … dauert meist unter einer Minute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ files so far… usually under a minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ archivos por ahora… suele tardar menos de un minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fichiers jusqu’à présent… généralement moins d’une minute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これまでに%@個のファイルをインデックス済み… 通常1分未満で完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금까지 %@개 파일 인덱싱됨… 보통 1분 이내에 완료됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ arquivos até agora… geralmente leva menos de um minuto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前已索引 %@ 个文件…通常不到一分钟。"
          }
        }
      }
    },
    "%@ is a symbolic link.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist ein symbolischer Link."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is a symbolic link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es un enlace simbólico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est un lien symbolique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はシンボリックリンクです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 파일은 심볼릭 링크입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é um link simbólico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是符号链接。"
          }
        }
      }
    },
