            "value": "El Acceso total al disco está desactivado, por lo que no se encontrarán algunos archivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Accès complet au disque est désactivé ; certains fichiers seront introuvables"
          }
        },
        "ja": {
