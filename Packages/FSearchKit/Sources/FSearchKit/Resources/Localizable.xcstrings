    "Alfred may use ⌥ Space. Pick another shortcut, or change Alfred's.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alfred verwendet möglicherweise ⌥ Leertaste. Wähle einen anderen Kurzbefehl oder ändere den von Alfred."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alfred may use ⌥ Space. Pick another shortcut, or change Alfred's."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que Alfred use ⌥ Espacio. Elige otro atajo o cambia el de Alfred."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alfred utilise peut-être ⌥ Espace. Choisissez un autre raccourci ou modifiez celui d’Alfred."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Alfredが⌥ Spaceを使用している可能性があります。別のショートカットを選ぶか、Alfred側の設定を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Alfred가 ⌥ Space를 사용 중일 수 있습니다. 다른 단축키를 선택하거나 Alfred의 단축키를 변경하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Alfred pode usar ⌥ Espaço. Escolha outro atalho ou altere o do Alfred."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Alfred 可能占用了 ⌥ 空格键。请选取其他快捷键，或更改 Alfred 的快捷键。"
          }
        }
      }
    },
