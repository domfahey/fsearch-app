          }
        }
      }
    },
    "FSearch is running from a temporary location macOS made for it, so its background helper can't stay registered. Choose Move to Applications to copy FSearch to your Applications folder and reopen it from there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FSearch wird von einem temporären Ort gestartet, den macOS dafür angelegt hat, weshalb der Hintergrunddienst nicht dauerhaft registriert bleiben kann. Wähle „In ‚Programme‘ bewegen“, um FSearch in deinen Ordner „Programme“ zu kopieren und von dort neu zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FSearch is running from a temporary location macOS made for it, so its background helper can't stay registered. Choose Move to Applications to copy FSearch to your Applications folder and reopen it from there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FSearch se está ejecutando desde una ubicación temporal creada por macOS, por lo que su proceso auxiliar en segundo plano no puede permanecer registrado. Elige Mover a Aplicaciones para copiar FSearch en tu carpeta Aplicaciones y volver a abrir la app desde allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FSearch s’exécute depuis un emplacement temporaire créé par macOS ; son assistant en arrière-plan ne peut donc pas rester enregistré. Choisissez Déplacer vers Applications pour copier FSearch dans votre dossier Applications et le rouvrir depuis cet emplacement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FSearchはmacOSが作成した一時的な場所から実行されているため、バックグラウンドヘルパーの登録を維持できません。「アプリケーションに移動」を選択して、FSearchをアプリケーションフォルダにコピーし、そこから開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FSearch가 macOS에서 생성한 임시 위치에서 실행 중이므로 백그라운드 도우미를 등록 상태로 유지할 수 없습니다. ‘응용 프로그램으로 이동’을 선택하여 FSearch를 응용 프로그램 폴더로 복사한 뒤 그 위치에서 다시 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O FSearch está sendo executado em um local temporário criado pelo macOS, portanto seu auxiliar em segundo plano não pode permanecer registrado. Escolha “Mover para Aplicativos” para copiar o FSearch para a pasta Aplicativos e reabri-lo de lá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FSearch 正在 macOS 创建的临时位置中运行，因此其后台辅助程序无法保持注册状态。请选取“移到应用程序”，将 FSearch 拷贝到“应用程序”文件夹并从该位置重新打开。"
          }
        }
      }
    },
    "FSearch is running from the disk image, so its background helper can't stay registered. Choose Move to Applications to copy FSearch to your Applications folder and reopen it from there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FSearch wird aus dem Festplattenimage gestartet, weshalb der Hintergrunddienst nicht dauerhaft registriert bleiben kann. Wähle „In ‚Programme‘ bewegen“, um FSearch in deinen Ordner „Programme“ zu kopieren und von dort neu zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FSearch is running from the disk image, so its background helper can't stay registered. Choose Move to Applications to copy FSearch to your Applications folder and reopen it from there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FSearch se está ejecutando desde la imagen de disco, por lo que su proceso auxiliar en segundo plano no puede permanecer registrado. Elige Mover a Aplicaciones para copiar FSearch en tu carpeta Aplicaciones y volver a abrir la app desde allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FSearch s’exécute depuis l’image disque ; son assistant en arrière-plan ne peut donc pas rester enregistré. Choisissez Déplacer vers Applications pour copier FSearch dans votre dossier Applications et le rouvrir depuis cet emplacement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FSearchはディスクイメージから実行されているため、バックグラウンドヘルパーの登録を維持できません。「アプリケーションに移動」を選択して、FSearchをアプリケーションフォルダにコピーし、そこから開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FSearch가 디스크 이미지에서 실행 중이므로 백그라운드 도우미를 등록 상태로 유지할 수 없습니다. ‘응용 프로그램으로 이동’을 선택하여 FSearch를 응용 프로그램 폴더로 복사한 뒤 그 위치에서 다시 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O FSearch está sendo executado a partir da imagem de disco, portanto seu auxiliar em segundo plano não pode permanecer registrado. Escolha “Mover para Aplicativos” para copiar o FSearch para a pasta Aplicativos e reabri-lo de lá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FSearch 正在磁盘映像中运行，因此其后台辅助程序无法保持注册状态。请选取“移到应用程序”，将 FSearch 拷贝到“应用程序”文件夹并从该位置重新打开。"
          }
        }
      }
    },
