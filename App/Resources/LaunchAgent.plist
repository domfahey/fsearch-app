<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.domfahey.fsearch.daemon</string>
  <key>BundleProgram</key><string>Contents/Helpers/fsearch</string>
  <key>ProgramArguments</key><array><string>fsearch</string><string>serve</string></array>
  <key>RunAtLoad</key><true/>
  <!-- Respawn only after a crash: the daemon exits 0 when another fsearch
       daemon holds the socket lock (or it can't start), and must not be
       relaunched forever. -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
</dict></plist>
