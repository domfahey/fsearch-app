            "state": "translated",
            "value": "En Ajustes de privacidad, busca FSearch en la lista y actívalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les réglages de confidentialité, recherchez FSearch dans la liste et activez-le."
