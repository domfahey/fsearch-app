    "this app's background helper wasn't enabled, so the index there wasn't the app's to remove.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrunddienst dieser App war nicht aktiviert, daher durfte die App den dortigen Index nicht entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "this app's background helper wasn't enabled, so the index there wasn't the app's to remove."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "el proceso auxiliar en segundo plano de esta app no estaba activado, por lo que no correspondía a la app eliminar ese índice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "l’assistant en arrière-plan de cette app n’était pas activé, l’index qui s’y trouve ne lui appartenait donc pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリのバックグラウンドヘルパーが有効になっていなかったため、そこにあるインデックスはこのアプリによる削除対象外です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱의 백그라운드 도우미가 활성화되어 있지 않아 해당 인덱스는 이 앱이 제거할 대상이 아니었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o auxiliar em segundo plano deste aplicativo não estava ativado, portanto não cabia ao aplicativo remover o índice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 的后台辅助程序未启用，因此该处的索引不属于本 App 可移除的范围。"
          }
        }
      }
    },
    "“%@” is gone: moved or deleted": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist nicht mehr vorhanden: bewegt oder gelöscht"
