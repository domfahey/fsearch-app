    "Choose whether your shortcut, Search…, and fsearch:// links open the classic floating panel or the Search Window. Both remain available from the menu bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle aus, ob dein Kurzbefehl, „Suchen…“ und fsearch://-Links das klassische schwebende Fenster oder das Suchfenster öffnen. Beide bleiben über die Menüleiste erreichbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether your shortcut, Search…, and fsearch:// links open the classic floating panel or the Search Window. Both remain available from the menu bar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si el atajo, Buscar… y los enlaces fsearch:// abren el panel flotante clásico o la ventana de búsqueda. Ambos siguen disponibles desde la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez si votre raccourci, Rechercher… et les liens fsearch:// ouvrent le panneau flottant classique ou la fenêtre de recherche. Les deux restent accessibles depuis la barre des menus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカット、「検索…」、および fsearch:// リンクで従来のフローティングパネルと検索ウインドウのどちらを開くか選択します。どちらもメニューバーからいつでも開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키, 검색… 및 fsearch:// 링크가 클래식 플로팅 패널과 검색 윈도우 중 어느 쪽을 열지 선택합니다. 두 인터페이스 모두 메뉴 막대에서 언제든 열 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha se o atalho, Buscar… e os links fsearch:// abrem o painel flutuante clássico ou a Janela de Busca. Ambos continuam disponíveis na barra de menus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择快捷键、“搜索…”和 fsearch:// 链接默认打开经典浮动面板还是搜索窗口。两种界面都可随时从菜单栏打开。"
          }
        }
      }
    },
