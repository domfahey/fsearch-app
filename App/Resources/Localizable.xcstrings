    "Full Disk Access": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Festplattenvollzugriff"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Disk Access"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso total al disco"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès complet au disque"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルディスクアクセス"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 디스크 접근 권한"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso Total ao Disco"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全磁盘访问权限"
          }
        }
      }
    },
    "Full Disk Access belongs to the fsearch daemon that's already running. Grant it to your fsearch binary in Privacy Settings and restart that daemon, or skip for now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Festplattenvollzugriff gehört zum bereits laufenden fsearch-Daemon. Erteile ihn deiner fsearch-Programmdatei in den Datenschutzeinstellungen und starte den Daemon neu, oder überspringe diesen Schritt vorerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Disk Access belongs to the fsearch daemon that's already running. Grant it to your fsearch binary in Privacy Settings and restart that daemon, or skip for now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Acceso total al disco corresponde al daemon de fsearch que ya está en ejecución. Concédeselo a tu binario fsearch en Ajustes de privacidad y reinicia ese daemon, u omítelo por ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Accès complet au disque appartient au démon fsearch déjà en cours d’exécution. Accordez-le à votre exécutable fsearch dans les réglages de confidentialité, puis redémarrez ce démon ou ignorez cette étape pour le moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルディスクアクセスはすでに実行中のfsearchデーモンに紐づいています。プライバシー設定でfsearchバイナリに許可を与えてそのデーモンを再起動するか、今はスキップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 디스크 접근 권한은 이미 실행 중인 fsearch 데몬에 부여되어 있습니다. 개인정보 보호 설정에서 fsearch 바이너리에 권한을 부여하고 해당 데몬을 재시작하거나, 지금은 건너뛰세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Acesso Total ao Disco pertence ao daemon do fsearch que já está em execução. Conceda-o ao seu binário fsearch nos Ajustes de Privacidade e reinicie esse daemon, ou pule por enquanto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全磁盘访问权限归当前正在运行的 fsearch 守护进程所有。请在“隐私设置”中为 fsearch 可执行文件授予此权限并重启该守护进程，或暂时跳过。"
          }
        }
      }
    },
    "Full Disk Access can't be removed by an app. Remove FSearch from the list by hand, then quit and delete FSearch.app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Festplattenvollzugriff kann nicht von einer App entfernt werden. Entferne FSearch manuell aus der Liste, beende dann FSearch und lösche FSearch.app."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Disk Access can't be removed by an app. Remove FSearch from the list by hand, then quit and delete FSearch.app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app no puede revocar el Acceso total al disco. Elimina FSearch de la lista manualmente y luego sal de FSearch.app y elimínala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une app ne peut pas révoquer elle-même l’Accès complet au disque. Retirez FSearch de la liste manuellement, puis quittez et supprimez FSearch.app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルディスクアクセスはアプリからは削除できません。リストからFSearchを手動で削除してから、FSearchを終了してFSearch.appを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 전체 디스크 접근 권한을 직접 제거할 수 없습니다. 목록에서 FSearch를 수동으로 제거한 다음 FSearch.app을 종료하고 삭제하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um aplicativo não pode remover o Acesso Total ao Disco. Remova o FSearch da lista manualmente e, em seguida, encerre e apague o FSearch.app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 无法自行移除完全磁盘访问权限。请手动从列表中移除 FSearch，然后退出并删除 FSearch.app。"
          }
        }
      }
    },
