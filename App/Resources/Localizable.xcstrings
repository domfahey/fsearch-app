    "Not opening in %@: its code signature isn’t the genuine app’s. Opened with the default app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nicht in %@ geöffnet: Die Codesignatur entspricht nicht der echten App. Stattdessen mit der Standard-App geöffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not opening in %@: its code signature isn’t the genuine app’s. Opened with the default app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se abre en %@: su firma de código no pertenece a la app genuina. Se ha abierto con la app predeterminada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouverture annulée dans %@ : sa signature de code ne correspond pas à celle de l’application d’origine. Ouvert avec l’app par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@では開きません: コード署名が正規のアプリのものではありません。デフォルトのアプリで開きました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 앱에서 열지 않음: 코드 서명이 정품 앱의 서명과 일치하지 않습니다. 기본 앱으로 열었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não aberto em %@: a assinatura de código não é a do aplicativo genuíno. Aberto com o aplicativo padrão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未在 %@ 中打开：其代码签名并非正版 App 签名。已使用默认 App 打开。"
          }
        }
      }
    },
