    "Press Backspace in an empty search field to clear": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Zurücksetzen im leeren Suchfeld die Rückschritttaste drücken"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Backspace in an empty search field to clear"
          }
        },
        "es": {
