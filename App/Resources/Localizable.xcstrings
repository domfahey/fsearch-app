            "state": "translated",
            "value": "Pulsa Retroceso en un campo de búsqueda vacío para borrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Retour arrière dans un champ de recherche vide pour effacer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空の検索フィールドでBackspaceキーを押すとクリアされます"
          }
        },
        "ko": {
