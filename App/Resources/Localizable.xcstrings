    "In Privacy Settings, find FSearch in the list and turn it on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche in den Datenschutzeinstellungen in der Liste nach FSearch und aktiviere es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Privacy Settings, find FSearch in the list and turn it on."
          }
        },
        "es": {
