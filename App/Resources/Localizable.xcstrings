          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在空搜索栏中按退格键即可清除"
          }
        }
      }
    },
    "Press your shortcut from anywhere, type a few letters, and every file on your disk shows up as you type. Even inside files.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücke überall deinen Kurzbefehl, gib ein paar Buchstaben ein und jede Datei auf deiner Festplatte erscheint direkt beim Tippen – sogar Dateiinhalte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press your shortcut from anywhere, type a few letters, and every file on your disk shows up as you type. Even inside files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa tu atajo desde cualquier lugar, escribe unas cuantas letras y todos los archivos de tu disco aparecerán mientras escribes. Incluso dentro de los archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur votre raccourci où que vous soyez, saisissez quelques lettres et chaque fichier de votre disque apparaît au fil de la saisie. Même à l’intérieur des fichiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこからでもショートカットを押して数文字入力するだけで、ディスク上のあらゆるファイルが入力と同時に表示されます。ファイルの中身も検索できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어디서나 단축키를 누르고 몇 글자만 입력하면 디스크의 모든 파일이 입력과 동시에 표시됩니다. 파일 내부의 내용까지 찾을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione seu atalho de qualquer lugar, digite algumas letras e todos os arquivos do seu disco aparecerão enquanto você digita. Até mesmo dentro de arquivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时随地按下快捷键，输入几个字母，磁盘上的所有文件都会随输入实时呈现——连文件内容也不例外。"
          }
        }
      }
    },
